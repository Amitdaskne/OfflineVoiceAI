<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Offline AI" android:textSize="28sp" android:textColor="@color/ai_blue"
        android:textStyle="bold" android:layout_gravity="center" android:layout_marginTop="20dp"/>
        
    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Loading AI Model..." android:textColor="@color/text_gray"
        android:layout_gravity="center" android:layout_marginTop="8dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="24dp" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            
            <TextView android:id="@+id/tvUserText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text_white" android:textSize="16sp"
                android:layout_gravity="end" android:background="#222222" android:padding="12dp"
                android:layout_marginBottom="16dp" android:visibility="gone"/>
                
            <TextView android:id="@+id/tvAiText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/ai_blue" android:textSize="16sp"
                android:layout_gravity="start" android:background="#112233" android:padding="12dp"
                android:layout_marginBottom="16dp" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <ImageView android:id="@+id/btnMic" android:layout_width="80dp" android:layout_height="80dp"
        android:src="@android:drawable/ic_btn_speak_now" android:background="@drawable/bg_mic_button"
        android:padding="20dp" android:layout_gravity="center" android:layout_marginBottom="32dp"
        android:tint="@color/bg_dark"/>
</LinearLayout>
